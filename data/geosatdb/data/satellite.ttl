eor:satellite.1999-039A a eo-ont:Satellite ;
    rdfs:label "OKEAN-O"@en ;
    schema:alternateName "Okean-O"@en,
        "Okean-O No. 1L"@en,
        "Okean-O No. 510-33-301:RA"@en,
