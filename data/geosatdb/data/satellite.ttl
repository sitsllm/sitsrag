eor:satellite.2022-021A a eo-ont:Satellite ;
    rdfs:label "GOES 18"@en ;
    schema:alternateName "GOES T"@en,
        "GOES-18"@en,
        "GOES-T"@en,
        "Geostationary Operational Environmental Satellite - 18"@en,
        "Geostationary Operational Environmental Satellite 18"@en,
        "Geostationary Operational Environmental Satellite GOES-T"@en ;
    schema:name "GOES 18"@en ;
    mac:description "CEOS applications: Meteorology (primary mission), search and rescue, space environment monitoring, data collection platform, data gathering."@en,
        """GCMD definitions: NOAA’s GOES-T, the third in a series of four advanced geostationary weather satellites, blasted into orbit aboard a United Launch Alliance Atlas V 541 rocket at 4:38 p.m. ET today (March 1, 2022) from Cape Canaveral, Florida. GOES-T’s mission managers confirmed that its solar arrays successfully deployed at 8:28 p.m. EST, and the satellite was operating on its own power.

GOES-T will track destructive wildfires, lightning, Pacific Ocean-based storms, dense fog, and other hazards that threaten the U.S. West Coast, Hawaii and Alaska. It will also monitor solar activity and space weather to provide early warnings of disruptions to power grids, communications and navigation systems. 


“GOES-T joins the suite of advanced technology providing critical data and imagery to forecasters and researchers tracking hazardous weather and working toward building a climate ready nation,” said NOAA Administrator Rick Spinrad, Ph.D. 

Once GOES-T is positioned in a geostationary orbit 22,300 miles above the Earth, after approximately two weeks, it will be renamed GOES-18. After undergoing a full checkout and validating its six high-tech instruments, the new satellite will move to the GOES-West position and replace GOES-17 in early 2023. 

From there, it will constantly provide advanced imagery and atmospheric measurements. Observations from GOES-18 will be fed into the NOAA's National Weather Service’s computer models used by meteorologists to develop forecasts and help predict the formation, growth, intensity and movement of hazardous weather systems. 

https://www.noaa.gov/news-release/noaas-goes-t-blasts-into-orbit"""@en,
        "OSCAR description: 3rd flight unit of the GOES 3rd generation programme. Mission: operational meteorology. Substantial contribution to space weather."@en,
        "OSOidx functionOfSpaceObject: Spacecraft engaged in practical applications and uses of space technology such as weather or communications"@en,
        "UCS Purpose: Earth Observation"@en,
        "UCS Users: Government"@en,
        "UCS detailedPurpose: Earth Science/Meterology"@en ;
    smi:inclination "0.01"^^xsd:float ;
    smi:period "1436.1"^^xsd:float ;
    eo-ont:COSPARId "2022-021A" ;
    eo-ont:NORADId 51850 ;
    eo-ont:apogee "35787.0"^^xsd:float ;
    eo-ont:dataPortal "	http://cimss.ssec.wisc.edu/goes/goesdata.html"^^xsd:anyURI ;
    eo-ont:dryMass "2857.0"^^xsd:float ;
    eo-ont:launchDate "2022-03-01"^^xsd:date ;
    eo-ont:launchMass "5209.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.AFETR ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "36000.0"^^xsd:float ;
    eo-ont:orbitLongitude "-136.8"^^xsd:float ;
    eo-ont:orbitType eor:orbit_type.GEO_S ;
    eo-ont:owner eor:owner.US ;
    eo-ont:perigee "35786.0"^^xsd:float ;
    eo-ont:relatedSatId "CEOS:727",
        "GCMD:1d7d9f4c-18f5-49f2-bb53-1fb93efbbbc3",
        "ITC:satellite-124",
        "OSCAR:goes_18" ;
    eo-ont:satelliteAgency "NOAA, NASA"@en ;
    eo-ont:webInfo "http://www.goes-r.gov/"^^xsd:anyURI,
        "https://www.goes-r.gov/, https://www.noaa.gov/news-release/noaas-goes-t-blasts-into-orbit, https://developers.google.com/earth-engine/datasets/tags/goes-18"^^xsd:anyURI .

