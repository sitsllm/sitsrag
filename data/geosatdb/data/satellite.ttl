eor:satellite.2021-088A a eo-ont:Satellite ;
    rdfs:label "LANDSAT 9"@en ;
    schema:alternateName "LANDSAT-9"@en,
        "Landsat 9"@en,
        "Landsat-9"@en ;
    schema:name "LANDSAT 9"@en ;
    mac:description "CEOS applications: 5-year mission design life with at least 10 years of consumables. Earth resources, land surface, environmental monitoring, agriculture and forestry, disaster monitoring and assessment, ice and snow cover."@en,
        """GCMD definitions: Landsat 9—a partnership between NASA and the U.S. Geological Survey— will continue the Landsat program’s critical role in monitoring, understanding and managing the land resources needed to sustain human life.

Today’s increased rates of global land cover and land use change have profound consequences for weather and climate change, ecosystem function and services, carbon cycling and sequestration, resource management, the national and global economy, human health, and society.

Landsat is the only U.S. satellite system designed and operated to repeatedly observe the global land surface at a moderate scale that shows both natural and human-induced change.

Landsat 9 has been fast-tracked for a December 2020 launch.

More Information:
https://landsat.gsfc.nasa.gov/landsat-9/
https://www.usgs.gov/land-resources/nli/landsat/landsat-9"""@en,
        "OSCAR description: 2nd flight unit of the LDCM programme. Main mission: land observation. Improved instruments: OLI-2 and TIRS-2 (which are very similar in specification to the Landsat-8 OLI and TIRS) More information <a href=\"https://landsat.gsfc.nasa.gov/satellites/landsat-9/\"> here</a>"@en,
        "OSOidx functionOfSpaceObject: Spacecraft engaged in practical applications and uses of space technology such as weather or communications"@en,
        "UCS Purpose: Earth Observation"@en,
        "UCS Users: Government"@en,
        "UCS detailedPurpose: Earth Science"@en ;
    smi:inclination "98.19"^^xsd:float ;
    smi:period "98.83"^^xsd:float ;
    eo-ont:COSPARId "2021-088A" ;
    eo-ont:NORADId 49260 ;
    eo-ont:apogee "703.0"^^xsd:float ;
    eo-ont:dataPortal "https://earthexplorer.usgs.gov/, https://www.usgs.gov/landsat-missions/landsat-data-access"^^xsd:anyURI,
        "https://lta.cr.usgs.gov/"^^xsd:anyURI ;
    eo-ont:dryMass "2390.0"^^xsd:float ;
    eo-ont:ect "10:11:00"^^xsd:time ;
    eo-ont:launchDate "2021-09-27"^^xsd:date ;
    eo-ont:launchMass "2710.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.AFWTR ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "705.0"^^xsd:float ;
    eo-ont:orbitSense "Descending"@en ;
    eo-ont:orbitType eor:orbit_type.LEO_S ;
    eo-ont:owner eor:owner.US ;
    eo-ont:perigee "702.0"^^xsd:float ;
    eo-ont:relatedSatId "CEOS:772",
        "GCMD:5d3ce672-39fb-4dd5-be5e-55f81fb7f40f",
        "ITC:satellite-185",
        "OSCAR:landsat_9" ;
