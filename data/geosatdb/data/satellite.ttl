eor:satellite.1999-008B a eo-ont:Satellite ;
    rdfs:label "ORSTED"@en ;
    schema:alternateName "Oersted"@en,
        "Orsted"@en,
        "Ørsted"@en ;
    schema:name "ORSTED"@en ;
    mac:description "CEOS applications: Earth magnetic field mapping."@en,
        "OSCAR description: Single flight unit of the &Oslash;rsted programme. Main missions: Space weather (Earth's magnetic field). Significant contribution to temperature/humidity sounding."@en,
        "OSOidx functionOfSpaceObject: The Ørsted satellite, named after the Danish scientist Hans Christian Ørsted (1777-1851), is the first satellite mission since Magsat (1979-80) designed for high-precision mapping of the Earth’s magnetic field. It was launched with a Delta-II rocket from Vandenberg Air Force Base, California, on 23 February 1999 into a near-polar orbit. As the first satellite of the International Decade of Geopotential Field Research, the satellite and its instrumentation has been a model for current and forthcoming missions such as the Challenging MiniSatellite Payload (CHAMP) and Swarm....."@en ;
    smi:inclination "96.45"^^xsd:float ;
