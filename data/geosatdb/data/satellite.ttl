eor:satellite.2011-001A a eo-ont:Satellite ;
    rdfs:label "ELEKTRO-L 1 (GOMS 2)"@en ;
    schema:alternateName "Electro-L N1"@en,
        "Electro-L Number 1"@en,
        "Electro-L1"@en,
        "Elektro-L"@en,
        "Elektro-L N1"@en,
        "Elektro-L No. 1"@en,
        "GOMS 2 [Geostationary Operational Meteorological Satellite 2]"@en,
        "Geostationary Operational Meteorological Satellite"@en ;
    schema:name "ELEKTRO-L 1 (GOMS 2)"@en ;
    mac:description "CEOS applications: Hydrometeorology, heliogeophysics, climatology, cloud information."@en,
        "GCMD definitions: A next-generation series of meteorological satellites developed for the Russian Federal Space Agency by NPO Lavochkin. The first satellite, Elektro-L No.1, was launched on 2 January 2011. It is the first Russian weather satellite that successfully operates in geostationary orbit,  and is currently the second operational Russian weather satellite. The satellites have a mass of about 1620 kg and are designed to operate for 10 years each. They are capable of producing images of the Earth's whole hemisphere in both visible and infrared frequencies, providing data for climate change and ocean monitoring in addition to their primary weather forecasting role."@en,
        "OSCAR description: 1st flight unit of the Electro-L series. Mission: operational meteorology. Substantial contribution to space weather."@en,
        "OSOidx functionOfSpaceObject: Hydrometeorological satellite."@en,
        "UCS Purpose: Earth Observation"@en,
