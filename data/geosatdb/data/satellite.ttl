    eo-ont:apogee "593.0"^^xsd:float ;
    eo-ont:dryMass "300.0"^^xsd:float ;
    eo-ont:ect "10:30:00"^^xsd:time ;
    eo-ont:launchDate "2014-06-19"^^xsd:date ;
    eo-ont:launchMass "310.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.DLS ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "620.0"^^xsd:float ;
    eo-ont:orbitSense "Ascending"@en ;
