eor:satellite.2016-080A a eo-ont:Satellite ;
    rdfs:label "ARASE (ERG)"@en ;
    schema:alternateName "Arase"@en,
        "Arase (ERG)"@en,
        "ERG"@en,
        "Exploration of Energization and Radiation in Geospace"@en,
        "Exploration of energization and Radiation in Geospace"@en,
        "SPRINT-B"@en ;
    schema:name "ARASE (ERG)"@en ;
    mac:description "OSCAR description: Single satellite of the ERG programme, known as \"Arase\" in Japanese originally ERG. Main mission:Space weather, particularly in the magnetosphere and across the Van Allen belts. Highly-elliptical Earth Orbit (HEO), with perigee 300 km and apogee 30,000 km"@en,
        "OSOidx functionOfSpaceObject: The main objective of ARASE (ERG) is to understand acceleration, transportation and loss of energetic particles in the Van Allen belts. ARASE (ERG) directly observes plasma/particles and field/waves inside the Van Allen belts and provides the new information about the Van Allen belts’ activity. ARASE (EGR) will contribute to the space weather research by measuring the near-Earth plasma environment, which will be useful to reduce the risk of satellite damage."@en,
        "UCS Purpose: Space Science"@en,
        "UCS Users: Government"@en ;
    smi:inclination "31.37"^^xsd:float ;
    smi:period "560.07"^^xsd:float ;
    eo-ont:COSPARId "2016-080A" ;
    eo-ont:NORADId 41896 ;
    eo-ont:apogee "31828.0"^^xsd:float ;
    eo-ont:dryMass "350.0"^^xsd:float ;
    eo-ont:launchDate "2016-12-20"^^xsd:date ;
    eo-ont:launchMass "350.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.KSCUT ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "3000.0"^^xsd:float ;
    eo-ont:orbitType eor:orbit_type.HEO ;
    eo-ont:owner eor:owner.JPN ;
    eo-ont:perigee "430.0"^^xsd:float ;
    eo-ont:radarCrossSection "1.3395"^^xsd:float ;
    eo-ont:relatedSatId "OSCAR:arase_erg" ;
    eo-ont:satelliteAgency "JAXA"@en .

eor:satellite.2016-081A a eo-ont:Satellite ;
    rdfs:label "TANSAT"@en ;
    schema:alternateName "Carbon Satellite"@en,
        "Chinese Carbon Dioxide Observation Satellite"@en,
        "Exploratory Satellite for Atmospheric CO2"@en,
        "Tan Weixing"@en,
        "Tan weixing"@en,
        "TanSat"@en,
        "The Global Carbon Dioxide Observation Satellite"@en ;
    schema:name "TANSAT"@en ;
    mac:description "CEOS applications: the carbon dioxide (CO2) monitoring"@en,
        "GCMD definitions: The first Chinese Carbon Dioxide Observation Satellite Mission (TanSat) was launched on December 21, 2016. It carries two instruments on-board: the Atmospheric Carbon-dioxide Grating Spectrometer (ACGS) and the multiple-band Cloud and Aerosol Polarization Imager (CAPI). TanSat flies in a sun-synchronous low Earth orbit (LEO) with an equator crossing time around 13:30 local time. The satellite operates in three measurement modes: nadir (ND), glint (GL) and target (TG). The swath width of TanSat measurements is ~18 km across the satellite track and contains 9 footprints each with a size of 2 km × 2 km in nadir. Nadir and glint mode alternate orbit-by-orbit, and the TanSat nadir model ground track is typically between two OCO-2 tracks, which provides potential future opportunities for combined usage of both data products for increased spatial coverage."@en,
        "OSCAR description: First satellite of the TANSAT programme. also known as \"CarbonSat\". Main mission: measurement of CO2"@en,
        "OSOidx functionOfSpaceObject: Scientific research"@en,
        "UCS Purpose: Earth Observation"@en,
        "UCS Users: Government"@en,
        "UCS detailedPurpose: Earth Science"@en ;
    smi:inclination "98.51"^^xsd:float ;
    smi:period "98.66"^^xsd:float ;
    eo-ont:COSPARId "2016-081A" ;
    eo-ont:EOLDate "2022-02-01"^^xsd:date ;
    eo-ont:NORADId 41898 ;
    eo-ont:apogee "710.0"^^xsd:float ;
    eo-ont:dataPortal "http://satellite.nsmc.org.cn/PortalSite/Data/Satellite.aspx"^^xsd:anyURI,
        "http://satellite.nsmc.org.cn/portalsite/Data/DataView.aspx?SatelliteType=2&SatelliteCode=TANSAT"^^xsd:anyURI ;
    eo-ont:dryMass "600.0"^^xsd:float ;
    eo-ont:ect "13:30:00"^^xsd:time ;
    eo-ont:launchDate "2016-12-21"^^xsd:date ;
    eo-ont:launchMass "620.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.JSC ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "700.0"^^xsd:float ;
    eo-ont:orbitSense "Ascending"@en ;
    eo-ont:orbitType eor:orbit_type.LEO_S ;
    eo-ont:owner eor:owner.PRC ;
    eo-ont:perigee "680.0"^^xsd:float ;
    eo-ont:radarCrossSection "1.4246"^^xsd:float ;
    eo-ont:relatedSatId "CEOS:876",
        "GCMD:3b26dec5-2cb1-48ce-9873-048c321fdebe",
        "ITC:satellite-340",
        "OSCAR:tansat" ;
