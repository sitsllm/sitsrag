eor:satellite.2020-066A a eo-ont:Satellite ;
    rdfs:label "HAIYANG-2C"@en ;
    schema:alternateName "HY 2C"@en,
        "HY-2C"@en,
        "HY2-C"@en,
        "Hai Yang 2 hao 03 xing"@en,
        "Hai Yang 2-03"@en,
        "Hai Yang 2C"@en,
        "Haiyang 2C"@en,
        "Haiyang-2C"@en,
        "Ocean dynamics satellite C"@en ;
    schema:name "HAIYANG-2C"@en ;
    mac:description "CEOS applications: Detecting ocean surface temperature, wind field, wave and topography."@en,
        "GCMD definitions: The Haiyang-2 (HY-2) satellite series is a second generation ocean observation satellite, managed by the China National Space Administration (CNSA) and the Chinese Academy of Space Technology (CAST). It is the follow-on mission to the first generation, HY-1A and HY-1B. HY-2’s primary objective was to measure ocean dynamic and regional environmental trends in the microwave spectral range. Further, parameters such as marine wind vector, marine surface heat and Sea Surface Temperature (SST) aid aero-marine forecasts for the prevention of, and relief in the event of, natural disasters. The first Haiyang satellite, HY-2A, was launched in August 2011, producing observational data until its service was terminated in December 2021. The satellite series consists of eight satellites with four currently in operation and four more planned to be launched by 2025."@en,
        "OSCAR description: 3rd flight unit of the HY-2 programme. Main mission: ocean observation."@en,
        """OSOidx functionOfSpaceObject: Monitor and conduct research on the marine
environment and provide support services
for marine disaster prevention and
mitigation, protection of marine rights and
interests, development of marine resources,
marine environmental protection and marine
scientific research
"""@en,
        "UCS Purpose: Earth Observation"@en,
        "UCS Users: Government"@en,
        "UCS detailedPurpose: Earth Science"@en ;
    smi:inclination "66.0"^^xsd:float ;
    smi:period "104.09"^^xsd:float ;
    eo-ont:COSPARId "2020-066A" ;
    eo-ont:NORADId 46469 ;
    eo-ont:apogee "959.0"^^xsd:float ;
    eo-ont:dryMass "1500.0"^^xsd:float ;
    eo-ont:launchDate "2020-09-21"^^xsd:date ;
    eo-ont:launchMass "1500.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.JSC ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "957.0"^^xsd:float ;
    eo-ont:orbitType eor:orbit_type.LEO_I ;
    eo-ont:owner eor:owner.PRC ;
    eo-ont:perigee "945.0"^^xsd:float ;
    eo-ont:relatedSatId "CEOS:719",
        "GCMD:4079ce72-fd3a-4d69-b984-bb02406012ec",
        "OSCAR:hy_2c" ;
    eo-ont:satelliteAgency "NSOAS, CAST"@en ;
    eo-ont:webInfo "http://www.naoas.gov.cn/"^^xsd:anyURI,
        "https://www.eoportal.org/satellite-missions/hy-2a#eop-quick-facts-section"^^xsd:anyURI .

