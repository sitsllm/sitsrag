    eo-ont:satelliteAgency "NOAA, EUMETSAT, NASA"@en ;
    eo-ont:webInfo "Source: NOAA JPSS, https://www.jpss.noaa.gov/mission_and_instruments.html"^^xsd:anyURI,
        "http://www.jpss.noaa.gov"^^xsd:anyURI,
