eor:sensor.4f4a57a4-4b1a-4f8d-a82e-4a80f92eb116 a eo-ont:Sensor ;
    rdfs:label "GAP"@en ;
    schema:alternateName "GPS Attitude and Positioning Experiment"@en,
        "GPS receiver-based Attitude, Position, and profiling experiment (GAP)"@en ;
    schema:description "To measure spacecraft velocity and attitude as well as TEC (Total Electron Content) of the ionosphere"@en,
        "Travelling cross the Magnetosphere in a highly-elliptical orbit"@en,
        "Used for spacecraft position and attitude determination and for ionospheric radio occultation profiling measurements in which the relative phase delay of the measured L1 and L2 signals (at frequencies of 1.57542 GHz and 1.2276 GHz, respectively) from different satellites of the GPS constellation will be used to determine the electron density profile of the ionosphere using tomographic techniques. The GAP is turned on an average of 10% of the time, following a schedule devised by the science team."@en ;
    schema:name "GAP"@en ;
    eo-ont:identifier "4f4a57a4-4b1a-4f8d-a82e-4a80f92eb116" ;
    eo-ont:relatedIds "CEOS:1707"@en,
        "OSCAR:gap"@en ;
    eo-ont:sampling eor:sampling.Other ;
    eo-ont:sensorAgency "CSA"@en ;
    eo-ont:sensorStatus eor:sensorStatus.Operational ;
    eo-ont:sensorType eor:sensor_type.Space_environment .

