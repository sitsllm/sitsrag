eor:satellite.2023-052A a eo-ont:Satellite ;
    rdfs:label "INTELSAT 40E (IS-40E)"@en ;
    schema:alternateName "INTELSAT 40E"@en,
        "IS-40e"@en,
        "Intelsat 40e"@en,
        "Intelsat IS-40e"@en,
        "TEMPO"@en,
        "Tropospheric Emissions: Monitoring of Pollution"@en ;
    schema:name "INTELSAT 40E (IS-40E)"@en ;
    mac:description "CEOS applications: Hourly measurements of air pollution over North America, from Mexico City to the Canadian oil sands, at high spatial resolution. Measurements in ultraviolet and visible wavelengths will provide a suite of products including the key elements of tropospheric air pollution chemistry. Uses a commercial geostationary host spacecraft. Will be part of the first global geostationary constellation for pollution monitoring, along with European and Korean missions now in development."@en,
        "GCMD definitions: Maxar Technologies and Intelsat recently agreed to partner to host NASA’s Tropospheric Emissions: Monitoring of Pollution (TEMPO) instrument onboard the Intelsat 40e mission. In 2019, NASA selected Maxar to host the TEMPO instrument utilizing the U.S. Air Force Hosted Payload Solutions (HoPS) contract vehicle. Intelsat 40e is based on Maxar's 1300-class satellite platform and will provide commercial satellite communications for Intelsat customers in North and Central America. The satellite is scheduled to launch into geostationary orbit 22,236 miles above Earth's equator in 2022."@en,
        "OSCAR description: Actually not a specific satellite.  The TEMPO instrument is mounted on Intelsat 40e. Main mission: air quality Coverage CONUS"@en,
        "UCS Purpose: Communications"@en,
        "UCS Users: Commercial"@en ;
    smi:inclination "0.01"^^xsd:float ;
    smi:period "1436.12"^^xsd:float ;
    eo-ont:COSPARId "2023-052A" ;
    eo-ont:NORADId 56174 ;
    eo-ont:apogee "35791.0"^^xsd:float ;
    eo-ont:dataPortal "https://earthdata.nasa.gov/eosdis/daacs/asdc"^^xsd:anyURI ;
    eo-ont:dryMass "3000.0"^^xsd:float ;
    eo-ont:launchDate "2023-04-07"^^xsd:date ;
    eo-ont:launchMass "6013.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.AFETR ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "35786.0"^^xsd:float ;
    eo-ont:orbitLongitude "-90.99"^^xsd:float ;
    eo-ont:orbitType eor:orbit_type.GEO_S ;
    eo-ont:owner eor:owner.ITSO ;
    eo-ont:perigee "35783.0"^^xsd:float ;
    eo-ont:relatedSatId "CEOS:739",
        "GCMD:62de6540-a614-4770-9e68-fde03001fdb4",
        "ITC:satellite-343",
        "OSCAR:tempo" ;
