eor:satellite.2024-043B a eo-ont:Satellite ;
    rdfs:label "MUSAT2"@en ;
    schema:alternateName "MuSat-2"@en,
        "MuSat2"@en ;
    schema:name "MUSAT2"@en ;
    mac:description "GCMD definitions: A science antenna developed with support from NASA’s Earth Science Technology Office (ESTO) is now in low-Earth orbit aboard MuSat2, a commercial remote-sensing satellite flown by the aerospace company Muon Space. The dual-frequency science antenna was originally developed as part of the Next Generation GNSS Bistatic Radar Instrument (NGRx). Aboard MuSat2, it will help measure ocean surface wind speed—an essential data point for scientists trying to forecast how severe a burgeoning hurricane will become."@en,
        "OSCAR description: Main mission operational meteorology Substantial contribution climate monitoring Substantional contribution space weather Using GNSS-R to improve on CYGNSS mission"@en,
        "OSOidx functionOfSpaceObject: Spacecraft engaged in practical applications and uses of space technology such as weather or communications"@en ;
    smi:inclination "97.8"^^xsd:float ;
