    eo-ont:launchMass "4423.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.FRGUI ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "35786.0"^^xsd:float ;
    eo-ont:orbitLongitude "-100.7"^^xsd:float ;
    eo-ont:orbitType eor:orbit_type.HEO ;
