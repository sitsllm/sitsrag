eor:satellite.1998-067TG a eo-ont:Satellite ;
    rdfs:label "LIGHT-1"@en ;
    schema:alternateName "Light-1"@en ;
    schema:name "LIGHT-1"@en ;
    mac:description "CEOS applications: Light-1 is a 3U CubeSat satellite mission to study Terrestrial Gamma-ray Flashes (TGFs), upward directed bursts of X-rays and gamma-rays associated with thunderstorm activity. The mission will be based on an original detector design being developed at New York University Abu Dhabi (NYUAD)."@en,
        """OSOidx functionOfSpaceObject: Science and technology demonstration
Light-1 is a 3U CubeSat with a scientific mission to detect Terrestrial Gamma-ray Flashes (TGFs) that are associated with thunderstorm activities. It carries two different light sensing technologies and two different scintillation crystals, for testing their performance in space.
"""@en ;
    smi:inclination "51.63"^^xsd:float ;
    smi:period "87.6"^^xsd:float ;
    eo-ont:COSPARId "1998-067TG" ;
    eo-ont:EOLDate "2023-01-15"^^xsd:date ;
    eo-ont:NORADId 51509 ;
    eo-ont:apogee "157.0"^^xsd:float ;
