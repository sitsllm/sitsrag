    eo-ont:sensorTypeCode "High_resolution_optical_imagers"@en .

eor:geometry.Pushbroom a eo-ont:Geometry ;
    rdfs:label "Push-broom scanning"@en ;
    rdfs:comment "The pushbroom work mode, or along track scanning, has a line of sensors arranged perpendicular to the flight direction of the spacecraft."@en ;
    eo-ont:geometryCode "Pushbroom"@en .

eor:sampling.Sounding a eo-ont:Sampling ;
    rdfs:label "Sounding"@en ;
    rdfs:comment "NaN"^^xsd:double ;
    eo-ont:samplingCode "Sounding"@en .

eor:sensor_type.Imaging_multi-spectral_radiometers_vis-IR a eo-ont:SensorType ;
    rdfs:label "Imaging multi-spectral radiometers (vis/IR)"@en ;
    eo-ont:sensorTypeCode "Imaging_multi-spectral_radiometers_vis-IR"@en .

eor:waveband_region.MWIR a eo-ont:WavebandRegion ;
    rdfs:label "Mid-wave infrared"@en ;
    eo-ont:frequencyMax "100000.0"^^xsd:float ;
    eo-ont:frequencyMin "50000.0"^^xsd:float ;
    eo-ont:wavebandRegionCode "MWIR"@en ;
    eo-ont:wavelengthMax "6.0"^^xsd:float ;
    eo-ont:wavelengthMin "3.0"^^xsd:float .

eor:waveband_region.MW a eo-ont:WavebandRegion ;
    rdfs:label "Microwave"@en ;
    eo-ont:frequencyMax "30.0"^^xsd:float ;
    eo-ont:frequencyMin "0.2"^^xsd:float ;
    eo-ont:subband eor:waveband_region.C-Band,
        eor:waveband_region.K-Band,
        eor:waveband_region.Ka-Band,
        eor:waveband_region.Ku-Band,
        eor:waveband_region.L-Band,
        eor:waveband_region.P-Band,
        eor:waveband_region.S-Band,
        eor:waveband_region.X-Band ;
    eo-ont:wavebandRegionCode "MW"@en ;
    eo-ont:wavelengthMax "1000000.0"^^xsd:float ;
    eo-ont:wavelengthMin "10000.0"^^xsd:float .

eor:sensor_type.Space_environment a eo-ont:SensorType ;
    rdfs:label "Space environment"@en ;
    eo-ont:sensorTypeCode "Space_environment"@en .

