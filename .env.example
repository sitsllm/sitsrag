#
# Storage (SQLite) 
#
# SQLITE_INDEX_PATH=data/index.db
# SQLITE_RUNTIME_PATH=data/runtime.db
# SQLITE_CHECKPOINT_PATH=data/checkpoints.db

#
# LLM (Required)
#
CHAT_API_KEY=sk-ant-...
# CHAT_MODEL=claude-haiku-4-5-20251001

#
# Embeddings (Local, via fastembed)
# (Note: Model and dimension must match)
#
# EMBEDDING_MODEL=BAAI/bge-small-en
# EMBEDDING_DIM=384

#
# Reranker (Cohere hosted API — keeps rerank off the box's CPU)
# Models: rerank-v3.5 (multilingual, GA) | rerank-v4.0-pro | rerank-v4.0-fast
#
RERANKER_MODEL=rerank-v3.5
RERANKER_API_KEY=cohere_...

# 
# Environment
#
# Sets the Langfuse trace environment and tags logs (development, test, staging, production)
ENVIRONMENT=development

#
# Observability (optional, Langfuse SDK v4)
#
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_ENABLED=true
# Optional: app release/version attached to traces (read directly by the SDK)
# LANGFUSE_RELEASE=0.1.0

#
# Tuning (optional - defaults are sensible)
#

# LLM_TEMPERATURE=0.1
# LLM_REASONING_EFFORT=medium    # for o1/o3 models: low, medium, high
# LLM_MAX_TOKENS=4096
# LLM_REASONING_MAX_TOKENS=8192  # for reasoning models (o1/o3) — thinking tokens consume this budget

# RETRIEVAL_TOP_K=20          # candidates fed to the reranker (Cohere reranks off-box, so more is ~free)
# RERANK_TOP_K=5
# VECTOR_WEIGHT=0.7
# FTS_WEIGHT=0.3

# ONNX intra-op threads per local inference (embedding + reranking). Unset = all
# cores per call. Cap it (e.g. 1-2) to let concurrent requests parallelise across
# cores under load (higher throughput, slightly higher single-request latency).
# INFERENCE_THREADS=

#
# Agent budget (optional)
#
# Max ReAct iterations per request. Single flat budget — all users anonymous.
# AGENT_MAX_ITERATIONS=15

#
# Cost controls
#
# Global daily request ceiling. Set zero or below to disable it.
# DAILY_REQUEST_LIMIT=500
# When set, the daily-limit notice points users at your MCP server after reaching the limit.
# MCP_URL=
# DAILY_LIMIT_MESSAGE=You've reached today's usage limit for the public assistant. Please try again tomorrow.
# (Per-IP limiting is handled at nginx. See nginx/nginx.conf.)

#
# API server (optional)
#
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=["*"]

#
# Content sources (optional)
#
# SITSBOOK_URL=https://e-sensing.github.io/sitsbook
# SITS_REFERENCE_URL=https://e-sensing.github.io/sits

#
# Data paths (optional)
#
# GEOSATDB_DATA_DIR=data/geosatdb/data
# SPECTRAL_INDICES_PATH=data/spectral-indices/indices.json
# SITS_COLLECTIONS_PATH=data/sits/collections.txt

#
# Logging (optional)
#
# LOG_LEVEL=INFO
# LOG_JSON=false

#
# Production server (gunicorn)
#
# These vars are read by gunicorn.conf.py at container startup.
# They have no effect when running locally via `sitsrag serve` (dev only).
# WEB_CONCURRENCY=1                # Single worker (in-memory counters + SQLite writers)
# WORKER_TIMEOUT=300               # Hard kill timeout in seconds (SSE-friendly)
# WORKER_GRACEFUL_TIMEOUT=30       # Grace period on SIGTERM
# KEEPALIVE=5                      # Idle keep-alive timeout
# FORWARDED_ALLOW_IPS=127.0.0.1    # Trusted proxy IPs (compose overrides to "*")

#
# SSE / connection limits
#
# SSE_MAX_CONNECTIONS=200
# SSE_HEARTBEAT_INTERVAL=15         # Seconds between heartbeat comments
# SSE_MAX_QUEUE_SIZE=256            # Backpressure queue depth per stream

#
# CORS (production hardening)
#
# CORS_ALLOW_CREDENTIALS=false      # Forced to false when CORS_ORIGINS=["*"]

#
# Docker Compose
#
# IMAGE_TAG=latest                  # Tag for the built app image
# HTTP_PORT=80                      # Host port nginx publishes
