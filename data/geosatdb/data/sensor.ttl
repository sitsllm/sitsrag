eor:geometry.Nadir_viewing a eo-ont:Geometry ;
    rdfs:label "Nadir-viewing"@en ;
    rdfs:comment "In nadir-viewing, sensors or instruments on a satellite point directly downward toward the Earth's surface, looking at the nadir point. This is the point on the Earth's surface directly below the satellite."@en ;
    eo-ont:geometryCode "Nadir_viewing"@en .

