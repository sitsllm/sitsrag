eor:satellite.2022-173A a eo-ont:Satellite ;
    rdfs:label "SWOT"@en ;
    schema:alternateName "Surface Water Ocean Topography"@en,
        "Surface Water and Ocean Topography"@en ;
    schema:name "SWOT"@en ;
    mac:description "CEOS applications: 3 year nominal mission. Characterize ocean mesoscale and sub-mesoscale circulation at spatial resolutions = 15 km and inventory all terrestrial water bodies with surface area > (250 m)2 and rivers with width > 100 m"@en,
        """GCMD definitions: Ocean and surface water levels are measured over a 120-km (75-mi) wide swath with a ~20 km (~12 mi) gap along nadir using a Ka-band radar interferometer. KaRIn (Ka-band Radar Interferometer) has two antennas separated by a 10-meter boom. Radar pulses are transmitted by one antenna and received by both for interferometry, creating two parallel swaths of data. 

More information: https://swot.jpl.nasa.gov/mission/flight-systems/"""@en,
        "OSCAR description: Single flight unit of the SWOT programme. Main missions: ocean topography and waves, hydrology (inner land water). <span style=\"color: #111111; font-family: Roboto, sans-serif; font-size: 13.3333px; text-align: justify;\">Will survey at least 90% of the globe, studying Earth's lakes, rivers, reservoirs and oceans at least twice every 21 days. </span>"@en,
        "OSOidx functionOfSpaceObject: Earth observation satellite"@en ;
    smi:inclination "77.61"^^xsd:float ;
    smi:period "102.84"^^xsd:float ;
    eo-ont:COSPARId "2022-173A" ;
    eo-ont:NORADId 54754 ;
    eo-ont:apogee "894.0"^^xsd:float ;
    eo-ont:dataPortal "https://earthdata.nasa.gov/eosdis/daacs/podaac"^^xsd:anyURI,
        "https://podaac.jpl.nasa.gov/SWOT"^^xsd:anyURI,
        "https://www.aviso.altimetry.fr/en/missions/current-missions/swot/access-to-data.html"^^xsd:anyURI ;
    eo-ont:dryMass "2200.0"^^xsd:float ;
    eo-ont:launchDate "2022-12-16"^^xsd:date ;
    eo-ont:launchMass "2200.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.AFWTR ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "891.0"^^xsd:float ;
    eo-ont:orbitType eor:orbit_type.LEO_I ;
    eo-ont:owner eor:owner.US ;
    eo-ont:perigee "893.0"^^xsd:float ;
    eo-ont:relatedSatId "CEOS:646",
        "GCMD:63b6f3d6-3e9a-40c9-ae91-13f580c7b6c3",
        "ITC:satellite-336",
        "OSCAR:swot" ;
    eo-ont:repeatCycle "21.0"^^xsd:float ;
    eo-ont:satelliteAgency "CNES, NASA, UKSA, CSA"@en ;
    eo-ont:webInfo "Reference: https://swot.jpl.nasa.gov/"^^xsd:anyURI,
        "http://swot.jpl.nasa.gov"^^xsd:anyURI .

