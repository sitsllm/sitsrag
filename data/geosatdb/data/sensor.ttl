eor:waveband_region.VIS a eo-ont:WavebandRegion ;
    rdfs:label "Visible"@en ;
    eo-ont:frequencyMax "800000.0"^^xsd:float ;
    eo-ont:frequencyMin "400000.0"^^xsd:float ;
    eo-ont:subband eor:waveband_region.Blue,
        eor:waveband_region.Cyan,
        eor:waveband_region.Green,
        eor:waveband_region.Orange,
        eor:waveband_region.Red,
        eor:waveband_region.Violet,
        eor:waveband_region.Yellow ;
    eo-ont:wavebandRegionCode "VIS"@en ;
    eo-ont:wavelengthMax "0.75"^^xsd:float ;
    eo-ont:wavelengthMin "0.4"^^xsd:float .

