      Short_Name: GOES N-P SOUNDER
   End_Group
   Group: Orbit
      Orbit_Type: GEO > GEOSYNCHRONOUS > GEOSTATIONARY
   End_Group
   Creation_Date: 2009-02-12
   Online_Resource: http://goespoes.gsfc.nasa.gov/goes/spacecraft/goes_o_spacecraft.html
   Online_Resource: http://nssdc.gsfc.nasa.gov/nmc/spacecraftDisplay.do?id=2009-033A
