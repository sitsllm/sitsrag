eor:satellite.2019-015A a eo-ont:Satellite ;
    rdfs:label "PRISMA"@en ;
    schema:alternateName "PRecursore IperSpettrale della Missione Applicativa"@en ;
    schema:name "PRISMA"@en ;
    mac:description "CEOS applications: Land surface, agriculture and forestry, regional geology, land use studies, water resources, vegetation studies, coastal studies and soils."@en,
        "GCMD definitions: PRISMA is an Earth observation satellite with innovative electro-optical instrumentation which combines a hyperspectral sensor with a medium-resolution panchromatic camera. This combination allows the capability of observation based on the recognition of the geometrical characteristics of the scene, as well as hyperspectral determination of chemical-physical composition of objects present on the scene. PRISMA is a program completely funded by Italian Space Agency (ASI) and is a follow on of the cancelled Hyperspectral Satellite for Earth Observation (HypSEO) mission. The satellite was launched on March 22, 2019 aboard a Vega rocket."@en,
        "OSCAR description: Single flight unit of the PRISMA programme. Main mission: vegetation process study."@en,
        "UCS Purpose: Earth Observation"@en,
        "UCS Users: Government"@en,
        "UCS detailedPurpose: Hyperspectral Imaging"@en ;
    smi:inclination "97.87"^^xsd:float ;
    smi:period "97.06"^^xsd:float ;
    eo-ont:COSPARId "2019-015A" ;
    eo-ont:NORADId 44072 ;
