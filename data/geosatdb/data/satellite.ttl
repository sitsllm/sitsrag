eor:satellite.2024-149CD a eo-ont:Satellite ;
    rdfs:label "ARCTIC WEATHER SATELLITE"@en ;
    schema:alternateName "AWS"@en,
        "AWS PFM"@en,
        "Arctic Weather Satellite"@en,
        "Arctic Weather Satellite Proto-Flight Model"@en ;
    schema:name "ARCTIC WEATHER SATELLITE"@en ;
    mac:description "CEOS applications: AWS is the protoflight satellite for a planned constellation of meteorological microsatellites providing passive microwave soundings for global atmospheric temperature and humidity profiles soundings in all weather conditions, with frequent revisits over the Arctic and Antarctic polar regions. This constellation (called EPS-Sterna, which is named after the latin name Sterna for the Arctic Tern) will consist of 3 orbital planes with 2 satellites in each orbital plane. With a nominal satellite lifetime of 5 years, a first launch in 2029 and 2 replenishments of each orbit plane, a minimum mission lifetime for the full system of 13 years will be achieved. Local Solar time for AWS is 09:00 - 11:00 and EPS-Sterna Descending LST is 03:30, 07:30, 11:30."@en,
        "OSCAR description: Prototype satellite to improve coverage over the polar regions. Main mission: all-weather temperature and humidity profiles. 3-axis stabilised. There is a direct broadcast channel for real time data acquisition. Exact orbital parameters to be determined."@en ;
    smi:inclination "97.72"^^xsd:float ;
    smi:period "96.66"^^xsd:float ;
    eo-ont:COSPARId "2024-149CD" ;
    eo-ont:NORADId 60543 ;
    eo-ont:apogee "601.0"^^xsd:float ;
    eo-ont:dryMass "120.0"^^xsd:float ;
    eo-ont:ect "10:00:00"^^xsd:time ;
    eo-ont:launchDate "2024-08-16"^^xsd:date ;
    eo-ont:launchMass "125.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.AFWTR ;
    eo-ont:operationalStatus eor:operational_status.operational ;
    eo-ont:orbitAltitude "595.0"^^xsd:float ;
    eo-ont:orbitSense "Descending"@en ;
    eo-ont:orbitType eor:orbit_type.LLEO_S ;
    eo-ont:owner eor:owner.NOR ;
    eo-ont:perigee "596.0"^^xsd:float ;
    eo-ont:relatedSatId "CEOS:986",
        "OSCAR:aws_pfm" ;
    eo-ont:satelliteAgency "ESA, EUMETSAT"@en ;
    eo-ont:webInfo "https://www.esa.int/Applications/Observing_the_Earth/Meteorological_missions/Arctic_Weather_Satellite"^^xsd:anyURI .

