eor:satellite.2003-046A a eo-ont:Satellite ;
    rdfs:label "IRS-P6 (RESOURCESAT-1)"@en ;
    schema:alternateName "IRS-P6"@en,
        "Indian Remote Sensing Satellite-P6"@en,
