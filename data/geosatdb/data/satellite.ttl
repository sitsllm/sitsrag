eor:satellite.2018-081A a eo-ont:Satellite ;
    rdfs:label "HAIYANG-2B"@en ;
    schema:alternateName "HY 2B"@en,
        "HY-2B"@en,
        "HY2-B"@en,
        "Hai Yang 2 hao 02 xing"@en,
        "Hai Yang 2-02"@en,
        "Hai Yang 2B"@en,
        "Haiyang 2B"@en,
        "Haiyang-2B"@en,
        "Ocean dynamics satellite B"@en ;
    schema:name "HAIYANG-2B"@en ;
    mac:description "CEOS applications: Detecting ocean surface temperature, wind field, wave and topography."@en,
        "GCMD definitions: The HY-2 satellite is an oceanographic remote sensing satellite series developed by China's National Satellite Ocean Application Service (NSOAS); four satellites are planned: HY-2A (2011), HY-2B (2012), HY-2C (2015), HY-2D (2019). The objective of HY-2 is to monitor the dynamic ocean environment with radar sensors to measure sea surface wind field, sea surface height and sea surface temperature. It will include a dual-frequency radar altimeter in Ku and C-bands, a Ku-band rotating scatterometer and microwave imager. The orbit is sun-synchronous: the first 2 years with a 14-day cycle, then one year with geodetic orbit (168-day cycle, 5-day approx. subcycle)."@en,
        "OSCAR description: 2nd flight unit of the HY-2 programme. Main mission: ocean observation."@en,
        "OSOidx functionOfSpaceObject: Marine observation"@en,
        "UCS Purpose: Earth Observation"@en,
        "UCS Users: Government"@en,
        "UCS detailedPurpose: Earth Science"@en ;
    smi:inclination "99.33"^^xsd:float ;
