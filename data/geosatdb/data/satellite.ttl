eor:satellite.2019-068A a eo-ont:Satellite ;
    rdfs:label "ICON"@en ;
    schema:alternateName "Ionospheric Connection Explorer"@en,
        "Ionospheric Connection Explorer "@en ;
    schema:name "ICON"@en ;
    mac:description """GCMD definitions: The Ionospheric Connection Explorer will study the frontier of space: the dynamic zone high in our atmosphere where terrestrial weather from below meets space weather above. In this region, the tenuous gases are anything but quiet, as a mix of neutral and charged particles travel through in giant winds. These winds can change on a wide variety of time scales -- due to Earth's seasons, the day's heating and cooling, and incoming bursts of radiation from the sun.

This region of space and its changes have practical repercussions, given our ever-increasing reliance on technology -- this is the area through which radio communications and GPS signals travel. Variations there can result in distortions or even complete disruption of signals. In order to understand this complicated region of near-Earth space, called the ionosphere, NASA has developed the ICON mission. To understand what drives variability in the ionosphere requires a careful look at a complicated system that is driven by both terrestrial and space weather.

ICON will help determine the physics of our space environment and pave the way for mitigating its effects on our technology, communications systems and society.

Additional Information: https://www.nasa.gov/icon"""@en,
        "OSCAR description: ICON will collect data needed to establish the connection between storms that occur near Earth&rsquo;s surface and space-weather storms, to improve space weather prediction.  More details here https://www.nasa.gov/icon"@en,
        "OSOidx functionOfSpaceObject: Spacecraft engaged in practical applications and uses of space technology such as weather or communications"@en,
        "UCS Purpose: Space Science"@en,
        "UCS Users: Government"@en,
        "UCS detailedPurpose: Radar Imaging"@en ;
    smi:inclination "26.99"^^xsd:float ;
    smi:period "95.79"^^xsd:float ;
    eo-ont:COSPARId "2019-068A" ;
    eo-ont:NORADId 44628 ;
    eo-ont:apogee "566.0"^^xsd:float ;
    eo-ont:dataPortal "https://icon.ssl.berkeley.edu/Data"^^xsd:anyURI ;
    eo-ont:dryMass "288.0"^^xsd:float ;
    eo-ont:launchDate "2019-10-11"^^xsd:date ;
    eo-ont:launchMass "288.0"^^xsd:float ;
    eo-ont:launchSite eor:launch_site.ERAS ;
    eo-ont:operationalStatus eor:operational_status.nonoperational ;
    eo-ont:orbitAltitude "575.0"^^xsd:float ;
    eo-ont:orbitType eor:orbit_type.LLEO_I ;
    eo-ont:owner eor:owner.US ;
    eo-ont:perigee "547.0"^^xsd:float ;
    eo-ont:relatedSatId "GCMD:4a3988a7-f1c6-4c0a-a93b-9221adbca49b",
        "OSCAR:icon" ;
